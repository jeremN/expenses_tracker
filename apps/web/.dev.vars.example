# Copy to `.dev.vars` and edit. This file is committed; `.dev.vars` is
# gitignored. Wrangler / @cloudflare/vite-plugin auto-loads `.dev.vars`
# during `pnpm dev`. None of these values are loaded in production
# deploys (production reads `vars` from wrangler.jsonc only).

# When set, the Access auth check returns a fake user with this email
# instead of verifying a real Cf-Access-Jwt-Assertion. Leave commented
# out to require a real Access JWT (use this if you front local dev
# with a Cloudflare Tunnel).
CF_ACCESS_DEV_USER_EMAIL="you@example.com"
