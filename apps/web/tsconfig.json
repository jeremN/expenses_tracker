{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./src/*"],
      "@tracker/db": ["../../packages/db/src/index.ts"],
      "@tracker/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/db/src/**/*",
    "../../packages/shared/src/**/*"
  ],
  "exclude": ["node_modules", "dist", ".output"]
}
